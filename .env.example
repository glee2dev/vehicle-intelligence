# LLM backend: mock (no key, template narration for mode 3 only) | anthropic
LLM_BACKEND=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Sonnet 5+ / Opus 4.7+ reject temperature; thinking is adaptive by default. Set LLM_THINKING=disabled to turn it off.
LLM_THINKING=adaptive
LLM_EFFORT=

# Service wiring
PIPELINE_URL=http://localhost:8000
PIPELINE_PORT=8000
MIDDLEWARE_PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
MIDDLEWARE_API_KEY=
